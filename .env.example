# ==============================================================================
# Sirkula MVP - Environment Variables
# ==============================================================================
# 
# Salin file ini menjadi `.env.local` untuk menghubungkan ke instance Supabase Anda:
# cp .env.example .env.local
#
# Catatan:
# Jika variabel di bawah ini tidak diatur atau dibiarkan kosong, Sirkula otomatis
# berjalan dalam "Demo Mode" (Local Prototype) dengan autentikasi simulasi,
# sehingga aplikasi dapat diuji tanpa konfigurasi database eksternal.
# ==============================================================================

# Supabase Project URL (didapat dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Public Key untuk akses client-side dan SSR)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (Secret Key HANYA untuk backend, JANGAN diekspos ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
